# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Required to judge anything: TypeSafe Jev key (https://typesafe.ai)
JEV_API_KEY=
# Optional: register slash commands only in this server (instant updates while testing).
# Leave empty in production to register globally.
DEV_GUILD_ID=
# Where you open the dashboard from your browser: this machine's address and the dashboard port.
# `/log dashboard` hands out links to it, e.g. http://steamdeck.local:8080 or http://192.168.1.20:8080
# The Steam Machine install fills it in with this machine's name if it's empty.
DASHBOARD_URL=
# Timezone that defines the "day" each activity log entry is filed under.
BOT_TZ=Europe/London
# Log level
RUST_LOG=info,serenity=warn,songbird=warn
# Port the dashboard listens on inside the container (default 8080)
# DASHBOARD_PORT=8080
# Set by the Docker image; only needed when running with cargo directly:
# DATABASE_URL=sqlite://data/nicenovember.db
# WHISPER_MODEL=models/ggml-base.en.bin
